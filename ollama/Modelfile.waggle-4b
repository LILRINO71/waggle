FROM qwen3:4b-instruct-2507-q4_K_M
# Hermes refuses a runtime window under 64k. With flash attention + an 8-bit KV cache (set by Waggle Gateway.vbs
# and tune-ollama.ps1) 64k fits a 12 GB GPU completely; without them it needs ~13 GB and spills onto the CPU.
PARAMETER num_ctx 65536
PARAMETER temperature 0.6
